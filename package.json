{
  "name": "dungeon-crawler-engine",
  "version": "1.0.0",
  "description": "A top-down 2D dungeon crawler roguelike for the browser, built with TypeScript, Vite and PixiJS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:architecture && node scripts/check-audit-toolkit.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:audit": "npm run build && node scripts/check-audit-toolkit.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewveit2000/Dungeon-Crawler-Game-2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/matthewveit2000/Dungeon-Crawler-Game-2/issues"
  },
  "homepage": "https://github.com/matthewveit2000/Dungeon-Crawler-Game-2#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pixi.js": "^8.20.0"
  }
}
